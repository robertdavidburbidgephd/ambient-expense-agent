# ── Google Cloud ──────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=europe-west4

# ── Agent Runtime ─────────────────────────────────────────────────────────────
# Full resource name  OR  just the numeric ID – both are accepted.
# e.g. "8214064343021518848"  or
#      "projects/123/locations/europe-west4/reasoningEngines/8214064343021518848"
AGENT_RUNTIME_ID=your-agent-runtime-id

# ── Dashboard server ──────────────────────────────────────────────────────────
PORT=8080
